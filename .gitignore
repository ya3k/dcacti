# =============================================================================
# .gitignore for dcacti
# =============================================================================

# ─── Secrets / local config ──────────────────────────────────────────────────
src/backend/GameServer.Api/appsettings.Development.json
src/frontend/client/.env.local
src/frontend/client/.env.*.local
src/backend/.env

# ─── Build outputs ───────────────────────────────────────────────────────────
**/bin/
**/obj/
src/frontend/client/dist/

# ─── Local verification artifacts ────────────────────────────────────────────
# Screenshots and reports produced by smoke test and viewport scripts
src/frontend/client/viewport-shots/
**/*-shots/

# ─── Dependencies ────────────────────────────────────────────────────────────
**/node_modules/

# ─── IDE / OS ─────────────────────────────────────────────────────────────────
.vs/
.vscode/
*.user
.DS_Store
Thumbs.db

# ─── .NET ─────────────────────────────────────────────────────────────────────
*.suo
*.ncrunchproject
launchSettings.json
