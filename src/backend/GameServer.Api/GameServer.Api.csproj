<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\GameServer.Application\GameServer.Application.csproj" />
    <ProjectReference Include="..\GameServer.Infrastructure\GameServer.Infrastructure.csproj" />
    <ProjectReference Include="..\GameServer.Shared\GameServer.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Application session authentication (ADR-015 D6): the JWT Bearer
         authentication scheme is the single application authentication
         mechanism, used by both REST and the BattleHub access token.
         ADR-015 D7/D9/D11 fix what is validated (HS256; no `iss`;
         `aud` = `dcacti-backend`; `kid` = current or previous key);
         the package only supplies the handler. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.26" />

    <!-- Design-time only: required by the EF Core tools to build migrations for
         GameDbContext (DATABASE.md; ADR-006). PrivateAssets keeps it out of the
         application's published output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The local configuration channel for the application session's signing
         secret (ADR-015 D10): "in local development from an uncommitted .env
         file or a dotnet user-secrets store". The host reads the store in
         Development, and this identifier is what makes `dotnet user-secrets`
         addressable for this project. It is an opaque identifier, not a secret:
         the store itself lives outside the working tree, so no secret value is
         ever in a tracked file, a build output, or this file.

         The keys the secret is supplied under are named by
         ApplicationSessionOptions (ApplicationSession:CurrentKey:Secret and
         :KeyId); see src/backend/.env.example for the local setup. -->
    <UserSecretsId>dcacti-gameserver-api-application-session</UserSecretsId>
  </PropertyGroup>

</Project>
