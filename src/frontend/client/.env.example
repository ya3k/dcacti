# =============================================================================
# Frontend Environment Variables — TEMPLATE
# Copy to: src/frontend/client/.env.local (never committed to git)
# IMPORTANT: Only browser-safe values here — NO Discord Client Secret!
# =============================================================================

# ─── Discord (CLIENT ID only — secret stays on backend) ──────────────────────
VITE_DISCORD_CLIENT_ID=your_discord_application_id

# ─── Development authentication (TASK-181) ───────────────────────────────────
# Play the MVP loop in a NORMAL BROWSER TAB during Development — no Discord
# Activity iframe, no Discord SDK session, no manually injected token.
#
# Set this to `true` in .env.local (never committed) to opt in. It is off unless
# set, and it only has any effect in a development build (`npm run dev`): in a
# production bundle the development path does not exist, so this setting cannot
# become a production bypass.
#
# The backend must also be running in Development with its own opt-in
# (DevelopmentAuthentication__Enabled=true — see src/backend/.env.example). If it
# is not, the app reports an authentication error and connects nothing.
#
# Local flow:
#   1. Signing key (once; see src/backend/.env.example for the why):
#        dotnet user-secrets --project src/backend/GameServer.Api set "ApplicationSession:CurrentKey:Secret" "<at least 32 random bytes>"
#        dotnet user-secrets --project src/backend/GameServer.Api set "ApplicationSession:CurrentKey:KeyId" "dev-1"
#   2. Backend, in Development with the opt-in (Development authentication needs
#      BOTH conditions):
#        PowerShell:  $env:ASPNETCORE_ENVIRONMENT='Development'; $env:DevelopmentAuthentication__Enabled='true'; dotnet run --project src/backend/GameServer.Api
#        bash:        ASPNETCORE_ENVIRONMENT=Development DevelopmentAuthentication__Enabled=true dotnet run --project src/backend/GameServer.Api
#   3. Frontend:  cd src/frontend/client && npm run dev
#   4. Open a normal tab at http://localhost:5173/ — the app authenticates as the
#      fixed development Player, then loads its collection and reaches the Lobby.
#
# A page refresh re-authenticates through the same path: the session is held in
# memory only and is never persisted (ADR-015 D5 has no refresh and no
# revocation).
VITE_DEV_AUTH=

# ─── Cloudflare Tunnel ───────────────────────────────────────────────────────
# LOCAL DEV: leave both empty — Vite dev server proxies /api and /hubs to
# localhost:5000 automatically (see vite.config.ts).
#
# TUNNEL / DISCORD ACTIVITY TEST: set to your backend tunnel URL.
# Run: cloudflared tunnel --url http://localhost:5000
# Then paste the printed URL below (no trailing slash):
#
#   VITE_API_URL=https://xxxx-your-be-tunnel.trycloudflare.com
#   VITE_SIGNALR_URL=https://xxxx-your-be-tunnel.trycloudflare.com
#
# NOTE: both frontend and backend need a separate tunnel.
#   FE tunnel → http://localhost:5173  (what Discord Activity iframe loads)
#   BE tunnel → http://localhost:5000  (what the FE calls for API + SignalR)
#
# After getting the BE tunnel URL:
#   1. Paste it into VITE_API_URL and VITE_SIGNALR_URL below
#   2. Add the FE tunnel URL to appsettings.Development.json > Cors > AllowedOrigins
#   3. Add both tunnel URLs to Discord Developer Portal > OAuth2 > Redirects

VITE_API_URL=
VITE_SIGNALR_URL=
